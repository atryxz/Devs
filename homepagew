<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Basic Setup -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AttendX AI — Student Dashboard</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- Combined & Harmonized CSS -->
    <style>
        :root {
            --midnight-teal: #013137;
            --ocean-teal: #215E68;
            --dusty-turquoise: #297376;
            --soft-seafoam: #5C9396;
            --pale-ice-blue: #C1D9DE;
            
            --bg-main: #C1D9DE;
            --surface-card: rgba(1, 49, 55, 0.72);
            --surface-hover: rgba(1, 49, 55, 0.9);
            --border-subtle: rgba(193, 217, 222, 0.18);
            --text-main: #ffffff;
            --text-muted: #C1D9DE;
            --accent: #297376;
            
            --radius: 20px;
            --sidebar-width: 260px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--midnight-teal);
            color: #ffffff;
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* ---------- BACKGROUND & AMBIENT GLOWS ---------- */
        .gradient-bg {
            position: fixed;
            inset: 0;
            background: 
            radial-gradient(circle at top left, rgba(92, 147, 150, 0.25), transparent 40%),
            radial-gradient(circle at bottom right, rgba(33, 94, 104, 0.3), transparent 45%),
            var(--midnight-teal);
            z-index: -5;
        }

        .grid {
            position: fixed;
            inset: 0;
            background-image: 
            linear-gradient(rgba(193, 217, 222, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(193, 217, 222, 0.03) 1px, transparent 1px);
            background-size: 45px 45px;
            z-index: -4;
        }

        /* ---------- SIDEBAR NAVIGATION ---------- */
        .sidebar {
            width: var(--sidebar-width);
            background: rgba(1, 35, 40, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-right: 1px solid var(--border-subtle);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .sidebar.collapsed {
            transform: translateX(-100%);
        }

        .sidebar-header {
            padding: 24px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .sidebar-header i {
            font-size: 1.4rem;
            color: var(--pale-ice-blue);
        }

        .sidebar-header h2 {
            font-size: 1.1rem;
            font-weight: 800;
            letter-spacing: -0.01em;
        }

        .sidebar-menu {
            list-style: none;
            padding: 20px 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex-grow: 1;
        }

        .sidebar-item a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            color: var(--pale-ice-blue);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.3s ease;
            opacity: 0.8;
        }

        .sidebar-item a:hover, .sidebar-item.active a {
            background: linear-gradient(90deg, var(--pale-ice-blue), var(--soft-seafoam));
            color: var(--midnight-teal);
            opacity: 1;
            font-weight: 700;
            box-shadow: 0 4px 15px rgba(41, 115, 118, 0.3);
        }

        .sidebar-item a i {
            width: 20px;
            text-align: center;
        }

        /* ---------- MAIN CONTENT AREA ---------- */
        .main-content {
            flex-grow: 1;
            margin-left: var(--sidebar-width);
            display: flex;
            flex-direction: column;
            transition: margin-left 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            min-height: 100vh;
        }

        .main-content.expanded {
            margin-left: 0;
        }

        /* Top Header / Nav Toggle */
        .top-navbar {
            padding: 18px 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(1, 35, 40, 0.5);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-subtle);
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .menu-toggle-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-subtle);
            color: var(--pale-ice-blue);
            width: 40px;
            height: 40px;
            border-radius: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            transition: 0.3s ease;
        }

        .menu-toggle-btn:hover {
            background: var(--soft-seafoam);
            color: var(--midnight-teal);
        }

        .user-profile-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-subtle);
            padding: 6px 14px;
            border-radius: 50px;
        }

        .user-profile-pill img {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--pale-ice-blue);
        }

        .user-profile-pill span {
            font-size: 0.85rem;
            font-weight: 600;
        }

        /* Dashboard View Container */
        .dashboard-body {
            padding: 30px;
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 24px;
        }

        /* Glass Cards for Features */
        .dash-card {
            background: var(--surface-card);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius);
            padding: 24px;
            backdrop-filter: blur(20px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
            transition: transform 0.3s ease, border-color 0.3s ease;
        }

        .dash-card:hover {
            transform: translateY(-3px);
            border-color: var(--pale-ice-blue);
        }

        .dash-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .dash-card-header h3 {
            font-size: 1.05rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .dash-card-header h3 i {
            color: var(--soft-seafoam);
        }

        /* Specific Component Styles (Stubs) */
        .stub-content {
            font-size: 0.85rem;
            color: var(--pale-ice-blue);
            opacity: 0.8;
            line-height: 1.5;
        }

        /* Responsive Breakpoints */
        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
            }
            .sidebar.mobile-open {
                transform: translateX(0);
            }
            .main-content {
                margin-left: 0;
            }
        }
    </style>
</head>

<body>

    <!-- Background Ambiance -->
    <div class="gradient-bg"></div>
    <div class="grid"></div>

    <!-- Collapsible Sidebar -->
    <aside class="sidebar" id="app-sidebar">
        <div class="sidebar-header">
            <i class="fa-solid fa-graduation-cap"></i>
            <h2>AttendX Portal</h2>
        </div>
        <ul class="sidebar-menu">
            <li class="sidebar-item active">
                <a href="#attendance"><i class="fa-solid fa-calendar-check"></i> Attendance</a>
            </li>
            <li class="sidebar-item">
                <a href="#deadlines"><i class="fa-solid fa-clock"></i> Deadlines & Reminders</a>
            </li>
            <li class="sidebar-item">
                <a href="#materials"><i class="fa-solid fa-book-open"></i> Study Materials</a>
            </li>
            <li class="sidebar-item">
                <a href="#tracker"><i class="fa-solid fa-stopwatch"></i> Study Tracker</a>
            </li>
            <li class="sidebar-item">
                <a href="#messages"><i class="fa-solid fa-comments"></i> Teacher Chat</a>
            </li>
        </ul>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="main-content" id="main-content-area">
        
        <!-- Top Navbar -->
        <header class="top-navbar">
            <button class="menu-toggle-btn" id="sidebar-toggle" aria-label="Toggle Sidebar">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="user-profile-pill">
                <div style="width: 28px; height: 28px; border-radius: 50%; background: var(--pale-ice-blue); display: grid; place-items: center; color: var(--midnight-teal); font-weight: 700; font-size: 0.75rem;">S</div>
                <span>Student Portal</span>
            </div>
        </header>

        <!-- Dashboard Widgets Layout -->
        <main class="dashboard-body">
            
            <!-- 1. Attendance Overview -->
            <div class="dash-card">
                <div class="dash-card-header">
                    <h3><i class="fa-solid fa-calendar-check"></i> Attendance Record</h3>
                </div>
                <div class="stub-content">
                    Real-time attendance status, percentages, and historical logs tracking your presence across enrolled subjects.
                </div>
            </div>

            <!-- 2. Homework & Project Deadlines -->
            <div class="dash-card">
                <div class="dash-card-header">
                    <h3><i class="fa-solid fa-clock"></i> Deadlines & Reminders</h3>
                </div>
                <div class="stub-content">
                    Upcoming assignment countdowns, project milestone alerts, and automated reminders configured for your courses.
                </div>
            </div>

            <!-- 3. Study Materials Access -->
            <div class="dash-card">
                <div class="dash-card-header">
                    <h3><i class="fa-solid fa-book-open"></i> Study Materials</h3>
                </div>
                <div class="stub-content">
                    Centralized repository for documents, lecture notes, and media uploaded directly by instructors for accessible learning.
                </div>
            </div>

            <!-- 4. Study Tracker with Timer & Checklist -->
            <div class="dash-card">
                <div class="dash-card-header">
                    <h3><i class="fa-solid fa-stopwatch"></i> Active Study Tracker</h3>
                </div>
                <div class="stub-content">
                    Select a subject, assign a focus topic, configure session duration timers, and check off completed goals with notification support.
                </div>
            </div>

            <!-- 5. Subject Teacher Messaging -->
            <div class="dash-card">
                <div class="dash-card-header">
                    <h3><i class="fa-solid fa-comments"></i> Teacher Inquiry Hub</h3>
                </div>
                <div class="stub-content">
                    Direct communication portal allowing students to submit questions or clear confusions with respective subject faculty.
                </div>
            </div>

        </main>
    </div>

    <!-- Sidebar Toggle Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('app-sidebar');
            const mainContent = document.getElementById('main-content-area');
            const toggleBtn = document.getElementById('sidebar-toggle');

            if (!sidebar || !mainContent || !toggleBtn) return;

            toggleBtn.addEventListener('click', () => {
                if (window.innerWidth <= 768) {
                    sidebar.classList.toggle('mobile-open');
                } else {
                    sidebar.classList.toggle('collapsed');
                    mainContent.classList.toggle('expanded');
                }
            });
        });
    </script>
</body>

</html>
