<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Access</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- Styles -->
    <style>
        :root {
            --navy: #0B1F33;
            --aqua: #82E9DE;
            --mint: #DDF8F1;
            --yellow: #F4C95D;
            --font-main: 'Sora', 'Poppins', sans-serif;
            --radius: 24px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: var(--font-main); }
        body { background: var(--navy); color: #fff; min-height: 100vh; display: flex; flex-direction: column; justify-content: space-between; overflow-x: hidden; }

        .gradient-bg {
            position: fixed; inset: 0;
            background: radial-gradient(circle at top left, #82E9DE25, transparent 40%), radial-gradient(circle at bottom right, #F4C95D20, transparent 45%), var(--navy);
            z-index: -5;
        }
        .grid {
            position: fixed; inset: 0;
            background-image: linear-gradient(rgba(255, 255, 255, .04) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .04) 1px, transparent 1px);
            background-size: 45px 45px; z-index: -4;
        }

        header { padding: 25px 0; display: flex; justify-content: center; position: sticky; top: 0; z-index: 999; backdrop-filter: blur(18px); }
        nav { width: 90%; max-width: 1400px; display: flex; justify-content: space-between; align-items: center; padding: 18px 40px; border-radius: 22px; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .15); }
        .logo { display: flex; align-items: center; gap: 15px; text-decoration: none; color: white; }
        .logo i { font-size: 32px; color: var(--aqua); }
        .logo h2 { font-size: 26px; font-weight: 700; }

        .portal-wrapper { width: 90%; max-width: 440px; padding: 50px 0; margin: auto; }
        .portal-card { background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .15); border-radius: var(--radius); padding: 38px 32px; backdrop-filter: blur(22px); box-shadow: 0 20px 50px rgba(0,0,0,.25); }

        .avatar-container { display: flex; justify-content: center; margin-bottom: 20px; }
        .user-avatar { width: 70px; height: 70px; border-radius: 50%; background: linear-gradient(135deg, var(--aqua), #54d8c6); display: flex; align-items: center; justify-content: center; color: #072436; font-size: 2rem; }

        .portal-header { text-align: center; margin-bottom: 25px; }
        .portal-header h1 { font-size: 1.6rem; font-weight: 700; margin-bottom: 6px; }
        .portal-header p { font-size: 0.9rem; opacity: 0.85; color: var(--mint); }
        .hint-badge { margin-top: 8px; font-size: 0.8rem; background: rgba(244, 201, 93, 0.2); color: var(--yellow); padding: 4px 12px; border-radius: 20px; display: inline-block; font-weight: 600; }

        .role-switch { display: grid; grid-template-columns: 1fr 1fr; background: rgba(255, 255, 255, 0.06); padding: 4px; border-radius: 16px; margin-bottom: 24px; border: 1px solid rgba(255, 255, 255, 0.12); }
        .role-btn { background: transparent; border: none; color: #ffffff; font-family: inherit; font-size: 0.88rem; padding: 10px; cursor: pointer; border-radius: 12px; transition: all 0.3s ease; opacity: 0.75; }
        .role-btn.active { color: #08202d; background: linear-gradient(90deg, var(--aqua), #50c5b7); opacity: 1; font-weight: 700; }

        .auth-panel { display: none; }
        .auth-panel.active { display: block; }
        .input-group { margin-bottom: 18px; }
        .input-group label { display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--mint); margin-bottom: 8px; }
        .input-field { width: 100%; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 14px; padding: 13px 16px; font-family: inherit; font-size: 0.95rem; color: #ffffff; outline: none; }
        .input-field:focus { border-color: var(--aqua); background: rgba(255, 255, 255, 0.1); }

        .submit-btn { width: 100%; padding: 15px; background: linear-gradient(90deg, var(--aqua), #50c5b7); color: #08202d; font-family: inherit; font-size: 1rem; font-weight: 700; margin-top: 10px; border-radius: 50px; border: none; cursor: pointer; transition: 0.3s; }
        .submit-btn:hover { transform: translateY(-3px); box-shadow: 0 12px 25px rgba(130, 233, 222, 0.4); }

        .modal-overlay { position: fixed; inset: 0; background: rgba(8, 20, 32, 0.75); backdrop-filter: blur(8px); display: grid; place-items: center; z-index: 1000; opacity: 0; pointer-events: none; transition: 0.3s; }
        .modal-overlay.active { opacity: 1; pointer-events: auto; }
        .modal-card { background: #0b2236; border: 1px solid rgba(130, 233, 222, 0.3); border-radius: 20px; padding: 28px 24px; text-align: center; max-width: 340px; width: 90%; }
        .modal-btn { width: 100%; background: linear-gradient(90deg, var(--aqua), #50c5b7); color: #08202d; border: none; padding: 12px; border-radius: 40px; font-weight: 700; margin-top: 18px; cursor: pointer; }

        footer { padding: 40px 8%; display: flex; justify-content: space-between; border-top: 1px solid rgba(255, 255, 255, .08); font-size: 14px; }
        footer a { color: white; text-decoration: none; opacity: 0.75; }
    </style>
</head>

<body>
    <div class="gradient-bg"></div>
    <div class="grid"></div>

    <header>
        <nav>
            <a href="main.html" class="logo">
                <i class="fa-solid fa-qrcode"></i>
                <h2>Smart Portal</h2>
            </a>
            <div>
                <a href="main.html" style="color:white; text-decoration:none; font-weight:500;">Home</a>
            </div>
        </nav>
    </header>

    <div class="portal-wrapper">
        <div class="portal-card">
            
            <div class="avatar-container">
                <div class="user-avatar"><i class="fa-solid fa-user-lock"></i></div>
            </div>

            <div class="portal-header">
                <h1>Account Access</h1>
                <p>Log in with your assigned ID and Password</p>
                <div class="hint-badge"><i class="fa-solid fa-key"></i> Quick Login: ID: <b>123</b> | Password: <b>123</b></div>
            </div>

            <div class="role-switch">
                <button type="button" class="role-btn active" id="tab-student">Student</button>
                <button type="button" class="role-btn" id="tab-teacher">Teacher</button>
            </div>

            <div class="form-container">
                <!-- Student Form -->
                <form id="form-student" class="auth-panel active">
                    <div class="input-group">
                        <label>School Name</label>
                        <input type="text" id="student-school" class="input-field" value="Fluorescent Secondary School" required>
                    </div>
                    <div class="input-group">
                        <label>Student User ID</label>
                        <input type="text" id="student-userid" class="input-field" placeholder="123" required>
                    </div>
                    <div class="input-group">
                        <label>Password</label>
                        <input type="password" id="student-password" class="input-field" placeholder="123" required>
                    </div>
                    <button type="submit" class="submit-btn">Login as Student</button>
                </form>

                <!-- Teacher Form -->
                <form id="form-teacher" class="auth-panel">
                    <div class="input-group">
                        <label>School Name</label>
                        <input type="text" id="teacher-school" class="input-field" value="Fluorescent Secondary School" required>
                    </div>
                    <div class="input-group">
                        <label>Teacher User ID</label>
                        <input type="text" id="teacher-userid" class="input-field" placeholder="123" required>
                    </div>
                    <div class="input-group">
                        <label>Password</label>
                        <input type="password" id="teacher-password" class="input-field" placeholder="123" required>
                    </div>
                    <button type="submit" class="submit-btn">Login as Teacher</button>
                </form>
            </div>

        </div>
    </div>

    <!-- Modal Popup -->
    <div class="modal-overlay" id="modal-overlay">
        <div class="modal-card">
            <h3 id="modal-title" style="margin-bottom:10px;">Notice</h3>
            <p id="modal-msg" style="font-size:0.9rem; opacity:0.8; line-height:1.5;"></p>
            <button class="modal-btn" id="modal-close">Continue</button>
        </div>
    </div>

    <footer>
        <p>Smart Student & Teacher Portal</p>
        <a href="main.html">Home</a>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tabStudent = document.getElementById('tab-student');
            const tabTeacher = document.getElementById('tab-teacher');
            const formStudent = document.getElementById('form-student');
            const formTeacher = document.getElementById('form-teacher');

            const modalOverlay = document.getElementById('modal-overlay');
            const modalTitle = document.getElementById('modal-title');
            const modalMsg = document.getElementById('modal-msg');
            const modalClose = document.getElementById('modal-close');

            let activeRole = 'student';

            tabStudent.addEventListener('click', () => {
                activeRole = 'student';
                tabStudent.classList.add('active');
                tabTeacher.classList.remove('active');
                formStudent.classList.add('active');
                formTeacher.classList.remove('active');
            });

            tabTeacher.addEventListener('click', () => {
                activeRole = 'teacher';
                tabTeacher.classList.add('active');
                tabStudent.classList.remove('active');
                formTeacher.classList.add('active');
                formStudent.classList.remove('active');
            });

            let redirectTarget = null;

            function showNotice(title, msg, target = null) {
                modalTitle.textContent = title;
                modalMsg.textContent = msg;
                redirectTarget = target;
                modalOverlay.classList.add('active');
            }

            modalClose.addEventListener('click', () => {
                modalOverlay.classList.remove('active');
                if (redirectTarget) {
                    window.location.href = redirectTarget;
                }
            });

            function login(role) {
                const uid = document.getElementById(`${role}-userid`).value.trim();
                const pass = document.getElementById(`${role}-password`).value.trim();

                if (!uid || !pass) {
                    showNotice("Field Required", "Please enter your User ID and Password.");
                    return;
                }

                if (uid === "123" && pass === "123") {
                    if (role === "student") {
                        showNotice("Welcome Student!", "Login successful. Opening Student Dashboard...", "intropage.html");
                    } else {
                        showNotice("Welcome Instructor!", "Teacher login successful. Redirecting to Teacher Hub (teacher_dashboard.html)...", "teacher_dashboard.html");
                    }
                } else if (uid === "student123" || uid === "teacher123") {
                    if (role === "student") {
                        showNotice("Welcome!", "Login successful. Opening Student Dashboard...", "intropage.html");
                    } else {
                        showNotice("Welcome!", "Teacher login successful. Redirecting to Teacher Hub (teacher_dashboard.html)...", "teacher_dashboard.html");
                    }
                } else {
                    showNotice("Login Failed", "Invalid credentials. For quick testing use ID: 123 and Password: 123.");
                }
            }

            formStudent.addEventListener('submit', (e) => { e.preventDefault(); login('student'); });
            formTeacher.addEventListener('submit', (e) => { e.preventDefault(); login('teacher'); });
        });
    </script>

</body>

</html>
