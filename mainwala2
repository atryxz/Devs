    <!-- Inline Script -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {

            // ====================================================================================
            // 🌟 EXTERNAL CREDENTIALS LOADING (FETCH API)
            // ====================================================================================
            let VALID_ACCOUNTS = { student: [], teacher: [] };

            async function loadCredentials() {
                try {
                    const response = await fetch('credentials.json');
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    VALID_ACCOUNTS = await response.json();
                    console.log("Credentials loaded successfully:", VALID_ACCOUNTS);
                } catch (error) {
                    console.error("Failed to load credentials from credentials.json:", error);
                }
            }

            // Execute credential load
            loadCredentials();

            // ====================================================================================
            // HOMEPAGE INTERACTIVITY & ANIMATIONS
            // ====================================================================================

            // 1. Smooth Scroll for Anchor Links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener("click", function (e) {
                    const targetId = this.getAttribute("href");
                    if (targetId === "#") return;
                    
                    const target = document.querySelector(targetId);
                    if (target) {
                        e.preventDefault();
                        target.scrollIntoView({ behavior: "smooth" });
                    }
                });
            });

            // 2. Sticky Glass Navbar Background
            const header = document.querySelector("header");
            window.addEventListener("scroll", () => {
                if (window.scrollY > 50) {
                    header.style.background = "rgba(8, 20, 32, .75)";
                    header.style.backdropFilter = "blur(25px)";
                } else {
                    header.style.background = "transparent";
                    header.style.backdropFilter = "blur(18px)";
                }
            });

            // 3. Dynamic Nav Highlight on Scroll
            const sections = document.querySelectorAll("section");
            const navLinks = document.querySelectorAll("nav ul li a");

            window.addEventListener("scroll", () => {
                let current = "";
                sections.forEach(section => {
                    const sectionTop = section.offsetTop - 150;
                    if (window.scrollY >= sectionTop) {
                        current = section.getAttribute("id");
                    }
                });

                navLinks.forEach(link => {
                    link.classList.remove("active");
                    if (link.getAttribute("href") === "#" + current) {
                        link.classList.add("active");
                    }
                });
            });

            // 4. Scroll Reveal (Intersection Observer)
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("show");
                    }
                });
            }, { threshold: 0.15 });

            document.querySelectorAll(".feature-card, .about, .contact, .stats, .dashboard, .phone").forEach(el => {
                el.classList.add("fade-up");
                observer.observe(el);
            });

            // 5. Numerical Counter Animation
            const counters = document.querySelectorAll(".stats h2");
            let counted = false;

            window.addEventListener("scroll", () => {
                const statsSection = document.querySelector(".stats");
                if (!statsSection || counted) return;

                if (window.scrollY > statsSection.offsetTop - window.innerHeight + 100) {
                    counted = true;

                    counters.forEach(counter => {
                        const rawText = counter.innerText.trim();
                        const targetNum = parseInt(rawText, 10);
                        const suffix = rawText.replace(targetNum.toString(), "");
                        
                        let currentNum = 0;
                        const step = Math.ceil(targetNum / 50);

                        const timer = setInterval(() => {
                            currentNum += step;
                            if (currentNum >= targetNum) {
                                currentNum = targetNum;
                                clearInterval(timer);
                            }
                            counter.innerText = currentNum + suffix;
                        }, 30);
                    });
                }
            });

            // 6. Mouse Parallax for Background Blobs
            const blobs = document.querySelectorAll(".blob");
            document.addEventListener("mousemove", (e) => {
                const x = e.clientX / window.innerWidth;
                const y = e.clientY / window.innerHeight;

                blobs.forEach((blob, index) => {
                    const speed = (index + 1) * 20;
                    blob.style.transform = `translate(${x * speed}px, ${y * speed}px)`;
                });
            });

            // 7. Interactive Graph Dynamics
            const bars = document.querySelectorAll(".graph div");
            if (bars.length > 0) {
                setInterval(() => {
                    bars.forEach(bar => {
                        const randomHeight = Math.floor(Math.random() * 90) + 35;
                        bar.style.height = `${randomHeight}px`;
                    });
                }, 2000);
            }

            // 8. Phone Scanner Glow Pulse
            const phone = document.querySelector(".phone");
            if (phone) {
                let isGlowing = false;
                setInterval(() => {
                    phone.style.boxShadow = isGlowing 
                        ? "0 0 45px rgba(130, 233, 222, .45)" 
                        : "0 20px 40px rgba(0, 0, 0, .35)";
                    isGlowing = !isGlowing;
                }, 1500);
            }
        });
    </script>
</body>

</html>
