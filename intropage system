<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student & Teacher Portal</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- Combined & Harmonized CSS -->
    <style>
        :root {
            --navy: #0B1F33;
            --aqua: #82E9DE;
            --mint: #DDF8F1;
            --yellow: #F4C95D;
            --pink: #FFF4F4;
            --glass: rgba(255, 255, 255, .08);
            --border-subtle: rgba(255, 255, 255, .15);
            --font-main: 'Sora', 'Poppins', sans-serif;
            --sidebar-width: 280px;
            --radius: 24px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: var(--font-main);
            -webkit-tap-highlight-color: transparent;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--navy);
            color: #ffffff;
            font-family: var(--font-main);
            overflow-x: hidden;
            position: relative;
            min-height: 100vh;
            display: flex;
        }

        /* Background Gradients & Grid */
        .gradient-bg {
            position: fixed;
            inset: 0;
            background:
                radial-gradient(circle at top left, #82E9DE25, transparent 40%),
                radial-gradient(circle at bottom right, #F4C95D20, transparent 45%),
                radial-gradient(circle at center, #DDF8F115, transparent 60%),
                var(--navy);
            z-index: -5;
        }

        .grid {
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, .04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, .04) 1px, transparent 1px);
            background-size: 45px 45px;
            z-index: -4;
        }

        /* Ambient Blobs */
        .blob {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            opacity: .35;
            animation: float 14s infinite ease-in-out;
            pointer-events: none;
            z-index: -3;
        }

        .blob1 { width: 350px; height: 350px; background: var(--aqua); top: -120px; left: -100px; }
        .blob2 { width: 320px; height: 320px; background: var(--yellow); right: -80px; top: 200px; animation-delay: 2s; }
        .blob3 { width: 260px; height: 260px; background: #6be5a8; bottom: -100px; left: 45%; animation-delay: 4s; }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-35px); }
        }

        /* Smooth Collapsible Sidebar Navigation */
        .sidebar {
            width: var(--sidebar-width);
            background: rgba(11, 31, 51, 0.88);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border-right: 1px solid var(--border-subtle);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            overflow-y: auto;
            scrollbar-width: thin;
        }

        .sidebar.collapsed {
            transform: translateX(-100%);
        }

        .sidebar-header {
            padding: 28px 24px;
            display: flex;
            align-items: center;
            gap: 14px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .sidebar-header i {
            font-size: 1.8rem;
            color: var(--aqua);
        }

        .sidebar-header h2 {
            font-size: 1.25rem;
            font-weight: 700;
        }

        .sidebar-menu {
            list-style: none;
            padding: 24px 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .sidebar-item a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 18px;
            color: #ffffff;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 500;
            border-radius: 14px;
            transition: all 0.3s ease;
            opacity: 0.85;
        }

        .sidebar-item a:hover,
        .sidebar-item.active a {
            background: linear-gradient(90deg, var(--aqua), #50c5b7);
            color: #08202d;
            opacity: 1;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(130, 233, 222, 0.35);
        }

        .sidebar-item a i {
            width: 22px;
            font-size: 1.1rem;
            text-align: center;
        }

        /* Sidebar Info Box - Explains feature on hover */
        .sidebar-info-box {
            margin: 20px 16px 24px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 18px;
            padding: 18px;
        }

        .sidebar-info-box h4 {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--aqua);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sidebar-info-box p {
            font-size: 0.82rem;
            line-height: 1.5;
            opacity: 0.85;
            color: var(--mint);
        }

        /* Main Content Area */
        .main-content {
            flex-grow: 1;
            margin-left: var(--sidebar-width);
            display: flex;
            flex-direction: column;
            transition: margin-left 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            min-height: 100vh;
            width: calc(100% - var(--sidebar-width));
        }

        .main-content.expanded {
            margin-left: 0;
            width: 100%;
        }

        /* Top Navbar */
        .top-navbar {
            padding: 20px 35px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(11, 31, 51, 0.7);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-subtle);
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .menu-toggle-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--border-subtle);
            color: var(--aqua);
            width: 44px;
            height: 44px;
            border-radius: 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            transition: 0.3s ease;
        }

        .menu-toggle-btn:hover {
            background: var(--aqua);
            color: #08202d;
            box-shadow: 0 0 15px rgba(130, 233, 222, 0.4);
        }

        .nav-right-actions {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .user-profile-pill {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--border-subtle);
            padding: 8px 18px;
            border-radius: 50px;
        }

        .user-profile-pill .avatar-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--aqua), #54d8c6);
            display: grid;
            place-items: center;
            color: #072436;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .user-profile-pill span {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .logout-btn {
            background: rgba(255, 107, 107, 0.15);
            border: 1px solid rgba(255, 107, 107, 0.3);
            color: #ff6b6b;
            padding: 9px 18px;
            border-radius: 50px;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            transition: 0.3s ease;
        }

        .logout-btn:hover {
            background: #ff6b6b;
            color: white;
            box-shadow: 0 5px 15px rgba(255, 107, 107, 0.4);
        }

        /* Dashboard Container */
        .dashboard-container {
            padding: 40px;
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 35px;
        }

        .dashboard-header-title h1 {
            font-size: 2.2rem;
            margin-bottom: 8px;
        }

        .dashboard-header-title h1 span {
            color: var(--aqua);
        }

        .dashboard-header-title p {
            color: var(--mint);
            opacity: 0.85;
            font-size: 1rem;
        }

        /* Split-View Feature Section Cards */
        .feature-module-card {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: var(--radius);
            padding: 35px;
            backdrop-filter: blur(22px);
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 35px;
            align-items: center;
            transition: transform 0.4s ease, border-color 0.3s ease, box-shadow 0.4s ease;
        }

        .feature-module-card:hover {
            transform: translateY(-4px);
            border-color: var(--aqua);
            box-shadow: 0 25px 55px rgba(130, 233, 222, 0.15);
        }

        .module-left {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .module-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 50px;
            background: rgba(130, 233, 222, 0.12);
            border: 1px solid rgba(130, 233, 222, 0.25);
            color: var(--aqua);
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 16px;
        }

        .module-left h2 {
            font-size: 1.75rem;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .module-left h2 i {
            color: var(--aqua);
        }

        .module-left p {
            font-size: 0.95rem;
            line-height: 1.7;
            opacity: 0.85;
            margin-bottom: 24px;
        }

        .feature-link-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 28px;
            background: linear-gradient(90deg, var(--aqua), #50c5b7);
            color: #08202d;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            border-radius: 50px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 8px 20px rgba(130, 233, 222, 0.3);
        }

        .feature-link-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(130, 233, 222, 0.45);
        }

        .module-right-preview {
            background: rgba(11, 31, 51, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 20px;
            padding: 24px;
            box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.4);
        }

        .preview-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .preview-header h4 {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--aqua);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Footer */
        footer {
            margin-top: 60px;
            padding: 40px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(255, 255, 255, .08);
        }

        footer p { opacity: .6; font-size: 14px; }
        footer a { color: white; text-decoration: none; opacity: .75; font-size: 14px; }

        @media (max-width: 1024px) {
            .feature-module-card { grid-template-columns: 1fr; }
        }

        @media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.mobile-open { transform: translateX(0); }
            .main-content { margin-left: 0; width: 100%; }
        }
    </style>
</head>

<body>

    <!-- Background Layers -->
    <div class="gradient-bg"></div>
    <div class="grid"></div>

    <div class="blob blob1"></div>
    <div class="blob blob2"></div>
    <div class="blob blob3"></div>

    <!-- Smooth Collapsible Sidebar Navigation -->
    <aside class="sidebar" id="app-sidebar">
        <div class="sidebar-header">
            <i class="fa-solid fa-qrcode"></i>
            <h2>Student Portal</h2>
        </div>

        <ul class="sidebar-menu">
            <li class="sidebar-item active" data-title="Attendance Overview" data-desc="Tracks class participation, total present days, and subject percentages in real-time.">
                <a href="#attendance"><i class="fa-solid fa-calendar-check"></i> Attendance Record</a>
            </li>
            <li class="sidebar-item" data-title="Deadlines & Reminders" data-desc="Keeps you updated on homework due dates, lab submissions, and exam countdowns.">
                <a href="#deadlines"><i class="fa-solid fa-clock"></i> Deadlines</a>
            </li>
            <li class="sidebar-item" data-title="Study Materials" data-desc="Central repository for downloading lecture slides, PDFs, and textbook resources.">
                <a href="#materials"><i class="fa-solid fa-book-open"></i> Study Materials</a>
            </li>
            <li class="sidebar-item" data-title="Study Focus Tracker" data-desc="Pomodoro focus timer and session duration tracking to maximize study productivity.">
                <a href="#tracker"><i class="fa-solid fa-stopwatch"></i> Focus Tracker</a>
            </li>
            <li class="sidebar-item" data-title="Teacher Inquiry Hub" data-desc="Direct messaging channel to consult subject instructors and clear course confusions.">
                <a href="#messages"><i class="fa-solid fa-comments"></i> Teacher Chat</a>
            </li>
        </ul>

        <!-- Sidebar Feature Overview Box -->
        <div class="sidebar-info-box">
            <h4 id="sidebar-info-title"><i class="fa-solid fa-circle-info"></i> Feature Overview</h4>
            <p id="sidebar-info-desc">Hover over any menu item above to see a quick introduction of what that feature does.</p>
        </div>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="main-content" id="main-content-area">
        
        <!-- Top Navbar -->
        <header class="top-navbar">
            <button class="menu-toggle-btn" id="sidebar-toggle" aria-label="Toggle Sidebar">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="nav-right-actions">
                <div class="user-profile-pill">
                    <div class="avatar-circle">S</div>
                    <span>Student Access</span>
                </div>
                <a href="login.html" class="logout-btn"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
            </div>
        </header>

        <!-- Dashboard Body Container -->
        <main class="dashboard-container">
            
            <div class="dashboard-header-title">
                <h1>Welcome to <span>Student Portal</span></h1>
                <p>Use the sidebar to explore features or click any button below to open its dedicated page.</p>
            </div>

            <!-- MODULE 1: ATTENDANCE RECORD -->
            <section id="attendance" class="feature-module-card">
                <div class="module-left">
                    <div class="module-badge"><i class="fa-solid fa-bolt"></i> Feature 1</div>
                    <h2><i class="fa-solid fa-calendar-check"></i> Attendance Record</h2>
                    <p>Track your daily class verification history, total present days, and subject-wise percentage logs in real-time.</p>

                    <a href="attendance.html" class="feature-link-btn">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Attendance File (attendance.html)
                    </a>
                </div>

                <div class="module-right-preview">
                    <div class="preview-header">
                        <h4><i class="fa-solid fa-chart-simple"></i> Attendance Preview</h4>
                        <span style="font-size:0.75rem; color:var(--aqua);">92% Present</span>
                    </div>
                    <p style="font-size:0.88rem; opacity:0.8; line-height:1.5;">
                        Contains historical attendance tables, scan timestamps, and subject participation breakdown.
                    </p>
                </div>
            </section>

            <!-- MODULE 2: DEADLINES & REMINDERS -->
            <section id="deadlines" class="feature-module-card">
                <div class="module-left">
                    <div class="module-badge"><i class="fa-solid fa-clock"></i> Feature 2</div>
                    <h2><i class="fa-solid fa-clock"></i> Deadlines & Reminders</h2>
                    <p>Stay updated with upcoming homework submissions, lab report deadlines, and project milestones.</p>

                    <a href="deadlines.html" class="feature-link-btn">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Deadlines File (deadlines.html)
                    </a>
                </div>

                <div class="module-right-preview">
                    <div class="preview-header">
                        <h4><i class="fa-solid fa-list-check"></i> Task Reminder Preview</h4>
                        <span style="font-size:0.75rem; color:var(--yellow);">3 Pending</span>
                    </div>
                    <p style="font-size:0.88rem; opacity:0.8; line-height:1.5;">
                        Manages assignment due dates, urgent task alerts, and submission countdown timers.
                    </p>
                </div>
            </section>

            <!-- MODULE 3: STUDY MATERIALS -->
            <section id="materials" class="feature-module-card">
                <div class="module-left">
                    <div class="module-badge"><i class="fa-solid fa-book"></i> Feature 3</div>
                    <h2><i class="fa-solid fa-book-open"></i> Study Materials Access</h2>
                    <p>Access centralized lecture slides, textbook PDFs, lab rubrics, and video course materials uploaded by teachers.</p>

                    <a href="materials.html" class="feature-link-btn">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Materials File (materials.html)
                    </a>
                </div>

                <div class="module-right-preview">
                    <div class="preview-header">
                        <h4><i class="fa-solid fa-folder-open"></i> Resource Library Preview</h4>
                        <span style="font-size:0.75rem; color:var(--mint);">48 Files</span>
                    </div>
                    <p style="font-size:0.88rem; opacity:0.8; line-height:1.5;">
                        Central repository containing lecture notes, PDF guides, and course presentations for easy download.
                    </p>
                </div>
            </section>

            <!-- MODULE 4: STUDY TRACKER -->
            <section id="tracker" class="feature-module-card">
                <div class="module-left">
                    <div class="module-badge"><i class="fa-solid fa-stopwatch"></i> Feature 4</div>
                    <h2><i class="fa-solid fa-stopwatch"></i> Active Study Tracker</h2>
                    <p>Boost your productivity using dedicated focus session timers, topic target tracking, and study duration analytics.</p>

                    <a href="tracker.html" class="feature-link-btn">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Focus Tracker File (tracker.html)
                    </a>
                </div>

                <div class="module-right-preview">
                    <div class="preview-header">
                        <h4><i class="fa-solid fa-stopwatch"></i> Focus Timer Preview</h4>
                        <span style="font-size:0.75rem; color:var(--aqua);">25m Pomodoro</span>
                    </div>
                    <p style="font-size:0.88rem; opacity:0.8; line-height:1.5;">
                        Dedicated focus stopwatch tool to run Pomodoro intervals and log daily study hours.
                    </p>
                </div>
            </section>

            <!-- MODULE 5: TEACHER CHAT -->
            <section id="messages" class="feature-module-card">
                <div class="module-left">
                    <div class="module-badge"><i class="fa-solid fa-comments"></i> Feature 5</div>
                    <h2><i class="fa-solid fa-comments"></i> Teacher Inquiry Hub</h2>
                    <p>Communicate directly with your subject instructors to clear confusions, submit project queries, or request academic guidance.</p>

                    <a href="messages.html" class="feature-link-btn">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Teacher Chat File (messages.html)
                    </a>
                </div>

                <div class="module-right-preview">
                    <div class="preview-header">
                        <h4><i class="fa-solid fa-comment-dots"></i> Messaging Preview</h4>
                        <span style="font-size:0.75rem; color:#7CFC98;">Prof. Davis Online</span>
                    </div>
                    <p style="font-size:0.88rem; opacity:0.8; line-height:1.5;">
                        Direct 1-on-1 chat room to send questions and receive replies from your course instructors.
                    </p>
                </div>
            </section>

        </main>

        <!-- Footer -->
        <footer>
            <p>Smart Student Portal</p>
            <a href="main.html">Home Page</a>
        </footer>

    </div>

    <!-- JavaScript Interactivity -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {

            // 1. Sidebar Toggle Logic
            const sidebar = document.getElementById('app-sidebar');
            const mainContent = document.getElementById('main-content-area');
            const toggleBtn = document.getElementById('sidebar-toggle');

            if (sidebar && mainContent && toggleBtn) {
                toggleBtn.addEventListener('click', () => {
                    if (window.innerWidth <= 768) {
                        sidebar.classList.toggle('mobile-open');
                    } else {
                        sidebar.classList.toggle('collapsed');
                        mainContent.classList.toggle('expanded');
                    }
                });
            }

            // 2. Sidebar Hover Feature Introduction
            const sidebarItems = document.querySelectorAll('.sidebar-item');
            const infoTitle = document.getElementById('sidebar-info-title');
            const infoDesc = document.getElementById('sidebar-info-desc');

            sidebarItems.forEach(item => {
                item.addEventListener('mouseenter', () => {
                    const title = item.getAttribute('data-title');
                    const desc = item.getAttribute('data-desc');
                    if (title && desc && infoTitle && infoDesc) {
                        infoTitle.innerHTML = `<i class="fa-solid fa-circle-info"></i> ${title}`;
                        infoDesc.textContent = desc;
                    }
                });

                item.addEventListener('click', () => {
                    sidebarItems.forEach(i => i.classList.remove('active'));
                    item.classList.add('active');
                });
            });

            // 3. Mouse Parallax for Background Blobs
            const blobs = document.querySelectorAll(".blob");
            document.addEventListener("mousemove", (e) => {
                const x = e.clientX / window.innerWidth;
                const y = e.clientY / window.innerHeight;

                blobs.forEach((blob, index) => {
                    const speed = (index + 1) * 20;
                    blob.style.transform = `translate(${x * speed}px, ${y * speed}px)`;
                });
            });
        });
    </script>
</body>

</html>
