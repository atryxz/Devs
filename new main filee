<!DOCTYPE html>
<html lang="en">

<head>

    <!-- Basic Setup -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AttendX AI — Modern Academic Ecosystem</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Sora:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- Combined & Harmonized CSS -->
    <style>
        :root {
            /* Ocean Teal Color Palette Harmonized with AttendX */
            --midnight-teal: #013137;
            --ocean-teal: #215E68;
            --dusty-turquoise: #297376;
            --soft-seafoam: #5C9396;
            --pale-ice-blue: #C1D9DE;
            
            /* Theme mapping */
            --navy: #013137;
            --aqua: #297376;
            --mint: #5C9396;
            --yellow: #F4C95D;
            --pink: #FFF4F4;
            --glass: rgba(255, 255, 255, 0.08);
            
            --bg-main: #C1D9DE;
            --surface-card: #FFFFFF;
            --surface-hover: #F0F6F7;
            --border-subtle: rgba(33, 94, 104, 0.15);
            --text-main: #013137;
            --text-muted: #215E68;
            --accent: #297376;
            
            --radius: 24px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--midnight-teal);
            color: #ffffff;
            overflow-x: hidden;
            position: relative;
            min-height: 100vh;
        }

        /* ---------- BACKGROUND & AMBIENT GLOWS ---------- */
        .gradient-bg {
            position: fixed;
            inset: 0;
            background: 
            radial-gradient(circle at top left, rgba(92, 147, 150, 0.25), transparent 40%),
            radial-gradient(circle at bottom right, rgba(33, 94, 104, 0.3), transparent 45%),
            radial-gradient(circle at center, rgba(41, 115, 118, 0.15), transparent 60%),
            var(--midnight-teal);
            z-index: -5;
        }

        .grid {
            position: fixed;
            inset: 0;
            background-image: 
            linear-gradient(rgba(193, 217, 222, 0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(193, 217, 222, 0.04) 1px, transparent 1px);
            background-size: 45px 45px;
            z-index: -4;
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.35;
            animation: float 14s infinite ease-in-out;
            pointer-events: none;
        }

        .blob1 {
            width: 350px;
            height: 350px;
            background: var(--soft-seafoam);
            top: -120px;
            left: -100px;
        }

        .blob2 {
            width: 320px;
            height: 320px;
            background: var(--dusty-turquoise);
            right: -80px;
            top: 200px;
            animation-delay: 2s;
        }

        .blob3 {
            width: 260px;
            height: 260px;
            background: var(--ocean-teal);
            bottom: -100px;
            left: 45%;
            animation-delay: 4s;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-35px); }
        }

        /* ---------- NAVBAR ---------- */
        header {
            width: 100%;
            display: flex;
            justify-content: center;
            padding: 25px 0;
            position: sticky;
            top: 0;
            z-index: 999;
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        nav {
            width: 90%;
            max-width: 1400px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 40px;
            border-radius: 22px;
            background: rgba(1, 49, 55, 0.65);
            border: 1px solid rgba(193, 217, 222, 0.15);
            box-shadow: 0 10px 30px rgba(1, 49, 55, 0.2);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .logo i {
            font-size: 28px;
            color: var(--pale-ice-blue);
        }

        .logo h2 {
            font-size: 26px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
        }

        .logo h2 span {
            color: var(--pale-ice-blue);
            font-weight: 400;
        }

        nav ul {
            display: flex;
            gap: 35px;
            list-style: none;
        }

        nav ul a {
            color: var(--pale-ice-blue);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: 0.3s;
        }

        nav ul a:hover, nav ul a.active {
            color: #ffffff;
        }

        .nav-buttons {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        /* ---------- BUTTONS ---------- */
        .login-btn,
        .start-btn,
        .primary-btn,
        .secondary-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            font-weight: 700;
            border-radius: 50px;
            font-size: 0.9rem;
        }

        .login-btn {
            padding: 12px 24px;
            color: var(--pale-ice-blue);
        }

        .login-btn:hover {
            color: #ffffff;
        }

        .start-btn, .primary-btn {
            padding: 14px 28px;
            background: linear-gradient(90deg, var(--pale-ice-blue), var(--soft-seafoam));
            color: var(--midnight-teal);
            box-shadow: 0 6px 20px rgba(41, 115, 118, 0.25);
        }

        .primary-btn {
            padding: 18px 35px;
            gap: 10px;
        }

        .secondary-btn {
            padding: 18px 35px;
            border: 2px solid var(--pale-ice-blue);
            color: var(--pale-ice-blue);
        }

        .primary-btn:hover,
        .start-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 30px rgba(92, 147, 150, 0.4);
            background: #ffffff;
            color: var(--midnight-teal);
        }

        .secondary-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            border-color: #ffffff;
        }

        /* ---------- HERO ---------- */
        .hero {
            width: 90%;
            max-width: 1400px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            min-height: 85vh;
            padding: 40px 0;
        }

        .hero-left {
            width: 48%;
        }

        .badge {
            display: inline-flex;
            gap: 10px;
            padding: 10px 20px;
            border-radius: 40px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(193, 217, 222, 0.2);
            margin-bottom: 30px;
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--pale-ice-blue);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .badge i {
            color: var(--yellow);
        }

        .hero h1 {
            font-size: 68px;
            line-height: 1.1;
            margin-bottom: 25px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .hero h1 span {
            color: var(--pale-ice-blue);
        }

        .hero p {
            font-size: 18px;
            line-height: 1.8;
            opacity: 0.85;
            max-width: 620px;
            margin-bottom: 40px;
        }

        .hero-buttons {
            display: flex;
            gap: 20px;
            margin-bottom: 45px;
        }

        /* ---------- STATS ---------- */
        .stats {
            display: flex;
            gap: 40px;
        }

        .stats h2 {
            font-size: 40px;
            color: var(--pale-ice-blue);
            font-weight: 800;
        }

        .stats p {
            margin-top: 8px;
            font-size: 15px;
            opacity: 0.7;
        }

        /* ---------- RIGHT HERO DASHBOARD / PHONE ---------- */
        .hero-right {
            width: 48%;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .dashboard {
            width: 520px;
            padding: 30px;
            background: rgba(1, 49, 55, 0.45);
            border: 1px solid rgba(193, 217, 222, 0.18);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            border-radius: 28px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .dashboard-header h3 {
            font-size: 1.15rem;
            font-weight: 700;
        }

        .online {
            color: #7CFC98;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .progress-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            background: rgba(255, 255, 255, 0.04);
            padding: 15px 20px;
            border-radius: 16px;
            border: 1px solid rgba(193, 217, 222, 0.08);
        }

        .progress-box h4 {
            font-size: 1rem;
            font-weight: 600;
        }

        .progress-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--pale-ice-blue), var(--soft-seafoam));
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 22px;
            font-weight: 800;
            color: var(--midnight-teal);
        }

        .attendance-box {
            display: flex;
            justify-content: space-between;
            margin-bottom: 35px;
            background: rgba(255, 255, 255, 0.04);
            padding: 15px;
            border-radius: 16px;
            border: 1px solid rgba(193, 217, 222, 0.08);
        }

        .attendance-box div {
            text-align: center;
            flex: 1;
        }

        .attendance-box h3 {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--pale-ice-blue);
        }

        .attendance-box p {
            font-size: 0.85rem;
            opacity: 0.7;
            margin-top: 4px;
        }

        .graph {
            display: flex;
            align-items: flex-end;
            gap: 12px;
            height: 120px;
            padding-top: 10px;
        }

        .graph div {
            flex: 1;
            background: linear-gradient(var(--pale-ice-blue), var(--dusty-turquoise));
            border-radius: 10px;
            animation: grow 2s infinite alternate;
        }

        .graph div:nth-child(1){height:45px;}
        .graph div:nth-child(2){height:90px;}
        .graph div:nth-child(3){height:65px;}
        .graph div:nth-child(4){height:120px;}
        .graph div:nth-child(5){height:80px;}
        .graph div:nth-child(6){height:105px;}
        .graph div:nth-child(7){height:100px;}

        @keyframes grow {
            from { transform: scaleY(0.8); }
            to { transform: scaleY(1); }
        }

        /* ---------- PHONE MOCKUP ---------- */
        .phone {
            position: absolute;
            right: -30px;
            bottom: -50px;
            width: 200px;
            height: 390px;
            border-radius: 30px;
            background: #011c21;
            padding: 14px;
            border: 4px solid #1a4951;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            animation: phoneFloat 5s infinite;
        }

        .phone-screen {
            width: 100%;
            height: 100%;
            border-radius: 20px;
            background: #012830;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            text-align: center;
            padding: 10px;
        }

        .qr-icon {
            font-size: 70px;
            color: var(--pale-ice-blue);
            margin-bottom: 15px;
        }

        .phone-screen h4 {
            font-size: 1rem;
            margin-bottom: 5px;
        }

        .phone-screen p {
            font-size: 0.75rem;
            opacity: 0.6;
        }

        .scan-line {
            position: absolute;
            width: 100%;
            height: 3px;
            background: var(--pale-ice-blue);
            animation: scan 2s infinite linear;
        }

        @keyframes scan {
            0% { top: 10%; }
            100% { top: 90%; }
        }

        @keyframes phoneFloat {
            50% { transform: translateY(-15px); }
        }

        /* ---------- FEATURES (BENTO GRID STYLE) ---------- */
        .features {
            width: 90%;
            max-width: 1400px;
            margin: 140px auto;
            text-align: center;
        }

        .features h2 {
            font-size: 48px;
            margin-bottom: 70px;
            line-height: 1.2;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .feature-card {
            background: rgba(1, 49, 55, 0.35);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(193, 217, 222, 0.12);
            border-radius: 28px;
            padding: 45px 30px;
            transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
            position: relative;
            overflow: hidden;
            text-align: left;
        }

        .feature-card::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            background: rgba(193, 217, 222, 0.08);
            border-radius: 50%;
            top: -90px;
            right: -90px;
            pointer-events: none;
        }

        .feature-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 25px 60px rgba(33, 94, 104, 0.3);
            border-color: var(--pale-ice-blue);
            background: rgba(1, 49, 55, 0.55);
        }

        .feature-card i {
            font-size: 48px;
            color: var(--pale-ice-blue);
            margin-bottom: 25px;
        }

        .feature-card h3 {
            font-size: 22px;
            margin-bottom: 15px;
            font-weight: 700;
        }

        .feature-card p {
            opacity: 0.75;
            line-height: 1.7;
            font-size: 0.95rem;
        }

        /* ---------- ABOUT ---------- */
        .about {
            width: 90%;
            max-width: 1200px;
            margin: 160px auto;
        }

        .about-content {
            background: rgba(1, 49, 55, 0.4);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 35px;
            padding: 70px;
            border: 1px solid rgba(193, 217, 222, 0.15);
            position: relative;
            overflow: hidden;
        }

        .about-content::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            background: rgba(244, 201, 93, 0.08);
            border-radius: 50%;
            right: -120px;
            bottom: -120px;
            pointer-events: none;
        }

        .about h2 {
            font-size: 44px;
            margin-bottom: 25px;
            font-weight: 800;
        }

        .about p {
            font-size: 18px;
            line-height: 1.9;
            opacity: 0.85;
            max-width: 850px;
        }

        /* ---------- CONTACT ---------- */
        .contact {
            width: 90%;
            max-width: 1000px;
            margin: 160px auto;
            text-align: center;
        }

        .contact h2 {
            font-size: 48px;
            margin-bottom: 20px;
            font-weight: 800;
        }

        .contact p {
            opacity: 0.75;
            margin-bottom: 35px;
            font-size: 1.1rem;
        }

        .contact a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 18px 40px;
            border-radius: 60px;
            background: linear-gradient(90deg, var(--pale-ice-blue), var(--soft-seafoam));
            color: var(--midnight-teal);
            font-weight: 800;
            text-decoration: none;
            transition: 0.3s;
            box-shadow: 0 10px 30px rgba(41, 115, 118, 0.25);
        }

        .contact a:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 45px rgba(92, 147, 150, 0.4);
            background: #ffffff;
        }

        /* ---------- FOOTER ---------- */
        footer {
            width: 100%;
            margin-top: 120px;
            padding: 50px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(193, 217, 222, 0.1);
            background: rgba(1, 25, 30, 0.5);
        }

        footer h3 {
            font-size: 26px;
            margin-bottom: 8px;
            font-weight: 700;
        }

        footer p {
            opacity: 0.6;
            font-size: 0.9rem;
        }

        footer div:last-child {
            display: flex;
            gap: 30px;
        }

        footer a {
            color: var(--pale-ice-blue);
            text-decoration: none;
            transition: 0.3s;
            opacity: 0.75;
            font-weight: 500;
        }

        footer a:hover {
            color: #ffffff;
            opacity: 1;
        }

        /* ---------- SCROLLBAR ---------- */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: var(--midnight-teal);
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(var(--dusty-turquoise), var(--soft-seafoam));
            border-radius: 20px;
        }

        /* ---------- FADE ANIMATION ---------- */
        .fade-up {
            opacity: 0;
            transform: translateY(40px);
            transition: 1s;
        }

        .fade-up.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* ---------- RESPONSIVE ---------- */
        @media(max-width: 1200px) {
            .hero {
                flex-direction: column;
                gap: 80px;
                text-align: center;
                min-height: auto;
            }

            .hero-left, .hero-right {
                width: 100%;
            }

            .hero-buttons {
                justify-content: center;
            }

            .stats {
                justify-content: center;
            }

            .phone {
                position: relative;
                right: auto;
                bottom: auto;
                margin-top: 40px;
            }

            .feature-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media(max-width: 768px) {
            nav {
                flex-direction: column;
                gap: 20px;
                padding: 20px;
            }

            nav ul {
                flex-wrap: wrap;
                justify-content: center;
                gap: 20px;
            }

            .hero h1 {
                font-size: 44px;
            }

            .hero p {
                font-size: 16px;
            }

            .hero-buttons {
                flex-direction: column;
            }

            .primary-btn, .secondary-btn {
                width: 100%;
            }

            .stats {
                flex-direction: column;
                gap: 20px;
            }

            .dashboard {
                width: 100%;
            }

            .phone {
                width: 180px;
                height: 360px;
            }

            .feature-grid {
                grid-template-columns: 1fr;
            }

            .features h2, .about h2, .contact h2 {
                font-size: 34px;
            }

            .about-content {
                padding: 35px;
            }

            footer {
                flex-direction: column;
                gap: 25px;
                text-align: center;
            }

            footer div:last-child {
                flex-wrap: wrap;
                justify-content: center;
            }
        }
    </style>

</head>

