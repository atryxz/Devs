/* ======================================
   ATTENDX AI HOMEPAGE
   PART A
====================================== */

/* ---------- VARIABLES ---------- */

:root{
    --navy:#0B1F33;
    --aqua:#82E9DE;
    --mint:#DDF8F1;
    --yellow:#F4C95D;
    --pink:#FFF4F4;
    --glass:rgba(255,255,255,.08);
}

/* ---------- BODY ---------- */

body{

    background:var(--navy);

    color:white;

    overflow-x:hidden;

    position:relative;

}

/* ---------- BACKGROUND ---------- */

.gradient-bg{

    position:fixed;

    inset:0;

    background:

    radial-gradient(circle at top left,#82E9DE25,transparent 40%),

    radial-gradient(circle at bottom right,#F4C95D20,transparent 45%),

    radial-gradient(circle at center,#DDF8F115,transparent 60%),

    var(--navy);

    z-index:-5;

}

/* ---------- GRID ---------- */

.grid{

    position:fixed;

    inset:0;

    background-image:

    linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),

    linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);

    background-size:45px 45px;

    z-index:-4;

}

/* ---------- FLOATING BLOBS ---------- */

.blob{

position:absolute;

border-radius:50%;

filter:blur(80px);

opacity:.35;

animation:float 14s infinite ease-in-out;

}

.blob1{

width:350px;

height:350px;

background:var(--aqua);

top:-120px;

left:-100px;

}

.blob2{

width:320px;

height:320px;

background:var(--yellow);

right:-80px;

top:200px;

animation-delay:2s;

}

.blob3{

width:260px;

height:260px;

background:#6be5a8;

bottom:-100px;

left:45%;

animation-delay:4s;

}

@keyframes float{

0%,100%{

transform:translateY(0);

}

50%{

transform:translateY(-35px);

}

}

/* ---------- NAVBAR ---------- */

header{

width:100%;

display:flex;

justify-content:center;

padding:25px 0;

position:sticky;

top:0;

z-index:999;

backdrop-filter:blur(18px);

}

nav{

width:90%;

max-width:1400px;

display:flex;

justify-content:space-between;

align-items:center;

padding:18px 40px;

border-radius:22px;

background:rgba(255,255,255,.06);

border:1px solid rgba(255,255,255,.15);

}

.logo{

display:flex;

align-items:center;

gap:15px;

}

.logo i{

font-size:32px;

color:var(--aqua);

}

.logo h2{

font-size:30px;

font-weight:700;

}

nav ul{

display:flex;

gap:35px;

list-style:none;

}

nav ul a{

color:white;

text-decoration:none;

font-weight:500;

transition:.3s;

}

nav ul a:hover{

color:var(--aqua);

}

.nav-buttons{

display:flex;

gap:15px;

}

/* ---------- BUTTONS ---------- */

.login-btn,

.start-btn,

.primary-btn,

.secondary-btn{

display:inline-flex;

align-items:center;

justify-content:center;

text-decoration:none;

transition:.3s;

font-weight:600;

border-radius:50px;

}

.login-btn{

padding:12px 24px;

color:white;

}

.start-btn{

padding:14px 28px;

background:linear-gradient(90deg,var(--aqua),#50c5b7);

color:#08202d;

}

.primary-btn{

padding:18px 35px;

background:linear-gradient(90deg,var(--aqua),#57d7c8);

color:#08202d;

gap:10px;

}

.secondary-btn{

padding:18px 35px;

border:2px solid var(--aqua);

color:white;

}

.primary-btn:hover,

.start-btn:hover{

transform:translateY(-5px);

box-shadow:0 15px 30px rgba(130,233,222,.4);

}

.secondary-btn:hover{

background:rgba(255,255,255,.08);

}

/* ---------- HERO ---------- */

.hero{

width:90%;

max-width:1400px;

margin:auto;

display:flex;

justify-content:space-between;

align-items:center;

min-height:90vh;

}

.hero-left{

width:48%;

}

.badge{

display:inline-flex;

gap:10px;

padding:10px 20px;

border-radius:40px;

background:rgba(255,255,255,.08);

margin-bottom:30px;

}

.badge i{

color:var(--yellow);

}

.hero h1{

font-size:74px;

line-height:1.05;

margin-bottom:25px;

}

.hero h1 span{

color:var(--aqua);

}

.hero p{

font-size:18px;

line-height:1.8;

opacity:.85;

max-width:620px;

margin-bottom:40px;

}

.hero-buttons{

display:flex;

gap:20px;

margin-bottom:45px;

}

/* ---------- STATS ---------- */

.stats{

display:flex;

gap:40px;

}

.stats h2{

font-size:40px;

color:var(--aqua);

}

.stats p{

margin-top:8px;

font-size:15px;

}

/* ---------- RIGHT ---------- */

.hero-right{

width:48%;

position:relative;

display:flex;

justify-content:center;

align-items:center;

}

/* ---------- DASHBOARD ---------- */

.dashboard{

width:520px;

padding:30px;

background:rgba(255,255,255,.08);

border:1px solid rgba(255,255,255,.15);

backdrop-filter:blur(22px);

border-radius:28px;

box-shadow:0 20px 50px rgba(0,0,0,.25);

}

.dashboard-header{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:25px;

}

.online{

color:#7CFC98;

}

.progress-box{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:30px;

}

.progress-circle{

width:110px;

height:110px;

border-radius:50%;

background:linear-gradient(135deg,var(--aqua),#54d8c6);

display:flex;

justify-content:center;

align-items:center;

font-size:30px;

font-weight:bold;

color:#072436;

}

.attendance-box{

display:flex;

justify-content:space-between;

margin-bottom:35px;

}

.attendance-box div{

text-align:center;

}

.graph{

display:flex;

align-items:flex-end;

gap:12px;

height:140px;

}

.graph div{

width:28px;

background:linear-gradient(var(--aqua),#4fc9bb);

border-radius:15px;

animation:grow 2s infinite alternate;

}

.graph div:nth-child(1){height:45px;}
.graph div:nth-child(2){height:90px;}
.graph div:nth-child(3){height:65px;}
.graph div:nth-child(4){height:120px;}
.graph div:nth-child(5){height:80px;}
.graph div:nth-child(6){height:135px;}
.graph div:nth-child(7){height:100px;}

@keyframes grow{

from{

transform:scaleY(.8);

}

to{

transform:scaleY(1);

}

}

/* ---------- PHONE ---------- */

.phone{

position:absolute;

right:-40px;

bottom:-50px;

width:220px;

height:430px;

border-radius:35px;

background:#08131e;

padding:18px;

border:4px solid #222;

box-shadow:0 20px 40px rgba(0,0,0,.4);

animation:phoneFloat 5s infinite;

}

.phone-screen{

width:100%;

height:100%;

border-radius:25px;

background:#0f2638;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

position:relative;

overflow:hidden;

}

.qr-icon{

font-size:90px;

color:var(--aqua);

margin-bottom:20px;

}

.scan-line{

position:absolute;

width:100%;

height:4px;

background:var(--aqua);

animation:scan 2s infinite linear;

}

@keyframes scan{

0%{top:10%;}

100%{top:90%;}

}

@keyframes phoneFloat{

50%{

transform:translateY(-15px);

}

}
/* ======================================
   FEATURES SECTION
====================================== */

.features{
    width:90%;
    max-width:1400px;
    margin:140px auto;
    text-align:center;
}

.features h2{
    font-size:52px;
    margin-bottom:70px;
    line-height:1.2;
}

.feature-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:30px;
}

.feature-card{
    background:rgba(255,255,255,.06);
    backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,.12);
    border-radius:28px;
    padding:45px 30px;
    transition:.4s;
    cursor:pointer;
    position:relative;
    overflow:hidden;
}

.feature-card::before{
    content:"";
    position:absolute;
    width:180px;
    height:180px;
    background:rgba(130,233,222,.15);
    border-radius:50%;
    top:-90px;
    right:-90px;
}

.feature-card:hover{
    transform:translateY(-15px);
    box-shadow:0 25px 60px rgba(130,233,222,.18);
    border-color:var(--aqua);
}

.feature-card i{
    font-size:60px;
    color:var(--aqua);
    margin-bottom:25px;
}

.feature-card h3{
    font-size:26px;
    margin-bottom:15px;
}

.feature-card p{
    opacity:.75;
    line-height:1.7;
}

/* ======================================
   ABOUT
====================================== */

.about{
    width:90%;
    max-width:1200px;
    margin:160px auto;
}

.about-content{
    background:rgba(255,255,255,.06);
    backdrop-filter:blur(20px);
    border-radius:35px;
    padding:70px;
    border:1px solid rgba(255,255,255,.12);
    position:relative;
    overflow:hidden;
}

.about-content::after{
    content:"";
    position:absolute;
    width:260px;
    height:260px;
    background:rgba(244,201,93,.12);
    border-radius:50%;
    right:-120px;
    bottom:-120px;
}

.about h2{
    font-size:48px;
    margin-bottom:25px;
}

.about p{
    font-size:19px;
    line-height:2;
    opacity:.85;
    max-width:850px;
}

/* ======================================
   CONTACT
====================================== */

.contact{
    width:90%;
    max-width:1000px;
    margin:160px auto;
    text-align:center;
}

.contact h2{
    font-size:52px;
    margin-bottom:20px;
}

.contact p{
    opacity:.8;
    margin-bottom:35px;
}

.contact a{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:18px 40px;
    border-radius:60px;
    background:linear-gradient(90deg,var(--aqua),#55d4c6);
    color:#082334;
    font-weight:700;
    text-decoration:none;
    transition:.3s;
}

.contact a:hover{
    transform:translateY(-6px);
    box-shadow:0 20px 45px rgba(130,233,222,.35);
}

/* ======================================
   FOOTER
====================================== */

footer{
    width:100%;
    margin-top:120px;
    padding:50px 8%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-top:1px solid rgba(255,255,255,.08);
